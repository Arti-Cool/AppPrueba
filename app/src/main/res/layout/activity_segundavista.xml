<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSegunda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Segunda Vista"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp" />

        <!-- Datos recibidos por putExtra desde Login -->
        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textAlignment="center"
            android:layout_marginBottom="20dp" />

        <!-- Implícito 2: página web -->
        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sitio web"
            android:inputType="textUri"
            android:text="https://www.santotomas.cl" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWeb"
            style="@style/BotonApp"
            android:text="🌐 Abrir sitio web" />

        <!-- Implícito 3: marcador telefónico -->
        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone"
            android:text="+56912345678" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLlamar"
            style="@style/BotonApp"
            android:text="📞 Llamar" />

        <!-- Implícito 4: correo -->
        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo"
            android:inputType="textEmailAddress"
            android:text="contacto@santotomas.cl" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCorreo"
            style="@style/BotonApp"
            android:text="✉️ Enviar correo" />

        <!-- Implícito 5: calendario -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCalendario"
            style="@style/BotonApp"
            android:text="📅 Agregar al calendario" />

        <!-- 🔙 Volver -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/BotonApp"
            android:text="🔙 Volver" />

    </LinearLayout>
</ScrollView>
